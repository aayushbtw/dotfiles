# Theme
theme = Github Dark

# Fonts
font-size = 14.5
font-family = JetBrains Mono
font-feature = calt
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09
font-feature = ss10
font-feature = liga

# Window
window-padding-x = 7
window-padding-y = 7
window-padding-balance = true
window-decoration = true

# Github Dark - palette 8
split-divider-color = #4D4D4D

unfocused-split-opacity = 0.92