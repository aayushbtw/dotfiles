{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(pnpm *)",
      "Bash(vp *)",
      "Bash(vpr *)",
      "Bash(vpx *)",
      "Bash(fd *)",
      "Bash(rg *)"
    ],
    "deny": ["Read(./.env.prod)", "Read(./build)"]
  },
  "model": "opus",
  "enableAllProjectMcpServers": false,
  "disableClaudeAiConnectors": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/usage/hook.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cloudflare@cloudflare": true,
    "orbit@orbit": true
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "tanstack-ai": {
      "source": {
        "source": "github",
        "repo": "TanStack/ai"
      }
    },
    "orbit": {
      "source": {
        "source": "directory",
        "path": "/Users/aayush/Projects/orbit"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
