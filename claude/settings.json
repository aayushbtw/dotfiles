{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 400,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git diff *)",
      "Bash(git reset *)",
      "Bash(git -C *)",
      "Bash(fd *)",
      "Bash(rg *)"
    ],
    "deny": [
      "Read(./.env.prod)",
      "Read(./build)"
    ],
    "ask": [
      "Bash(git push *)"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "cloudflare@cloudflare": false
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "tanstack-ai": {
      "source": {
        "source": "github",
        "repo": "TanStack/ai"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
