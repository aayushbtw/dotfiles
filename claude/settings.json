{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git diff *)",
      "Bash(git reset *)",
      "Bash(git -C *)"
    ],
    "ask": ["Bash(git push *)"],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./build)"]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "effortLevel": "medium",
  "model": "opus"
}
